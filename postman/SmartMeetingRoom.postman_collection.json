{
  "info": {
    "name": "SmartMeetingRoom",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{users_base_url}}/api/v1/users/register",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"demo\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"DemoPass123!\"\n}"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{users_base_url}}/api/v1/users/login",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"DemoPass123!\"\n}"}
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": "{{users_base_url}}/api/v1/users/me"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
            ],
            "url": "{{rooms_base_url}}/api/v1/rooms/",
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Demo Room\",\n  \"capacity\": 10,\n  \"location\": \"HQ\",\n  \"status\": \"AVAILABLE\"\n}"}
          }
        },
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": "{{rooms_base_url}}/api/v1/rooms/"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
            ],
            "url": "{{bookings_base_url}}/api/v1/bookings/",
            "body": {"mode": "raw", "raw": "{\n  \"room_id\": {{room_id}},\n  \"start_time\": \"2024-01-01T10:00:00Z\",\n  \"end_time\": \"2024-01-01T11:00:00Z\"\n}"}
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
            ],
            "url": "{{reviews_base_url}}/api/v1/reviews/rooms/{{room_id}}",
            "body": {"mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great room\"\n}"}
          }
        }
      ]
    }
  ]
}
